    {/* While the map loads the card is its words alone, edge, corners and
        shadow and all; once the map is halfway in, it stretches to its full
        height until its window shows the map. Run here, inline, so the first frame is
        already the closed card rather than the open one jumping shut. The
        veil's hole follows the window each frame; wellness-map.js leaves the
        hole alone until this is done. */}
    {!embed && <script is:inline set:html={`
(() => {
  const card = document.getElementById('story-card');
  const win = document.getElementById('story-window');
  const text = card && card.querySelector('.story-text');
  const head = card && card.querySelector('.story-head');
  const veil = document.getElementById('story-veil');
  if (!card || !win || !text || !veil) return;
  /* The card stays out of sight until the map's script has set the page up:
     it marks the frame with its map style, which the card's size rules key
     on, and before that the card would show at another size and then jump.
     Two seconds at most, whatever happens. */
  const frame = document.getElementById('frame');
  const styled = () => !!frame && (frame.classList.contains('is-paper') || frame.classList.contains('is-ready'));
  /* Declared here, not where it is filled in below: with reduced motion the
     script stops before that point, and the wait below must still be able to
     call it (as a no-op) and show the card. Reaching a const declared after
     an early return threw, and left the card hidden for good: only the
     window into the map showed, and readers had to click past it. */
  let settle = () => {};
  if (!styled()) {
    card.style.visibility = 'hidden';
    const t0 = performance.now();
    const wait = () => {
      if (styled() || performance.now() - t0 > 2000) { card.style.visibility = ''; try { settle(); } catch (e) {} return; }
      requestAnimationFrame(wait);
    };
    requestAnimationFrame(wait);
  }
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  window.__storyOpening = true;
  /* Shut, the card is as tall as its words need, with nothing of the window
     showing; open, it is its full height. Both are measured again the moment
     it opens, so a late stylesheet cannot leave it opening to a stale size
     and snapping at the end. */
  const measure = () => {
    card.style.height = 'auto';
    const s = card.getBoundingClientRect().height;
    card.style.height = '';
    const f = card.getBoundingClientRect().height;
    return [Math.min(s, f), f];
  };
  let shut = 0, full = 0;
  const hole = () => {
    const w = win.getBoundingClientRect(), v = veil.getBoundingClientRect(), cs = getComputedStyle(win);
    const x1 = w.left - v.left + (parseFloat(cs.borderLeftWidth) || 0);
    const y1 = w.top - v.top + (parseFloat(cs.borderTopWidth) || 0);
    const x2 = w.right - v.left - (parseFloat(cs.borderRightWidth) || 0);
    const y2 = w.bottom - v.top - (parseFloat(cs.borderBottomWidth) || 0);
    veil.style.clipPath = y2 > y1 + 0.5
      ? 'polygon(evenodd, 0 0, 100% 0, 100% 100%, 0 100%, 0 0, ' + x1 + 'px ' + y1 + 'px, ' + x2 + 'px ' + y1 + 'px, ' + x2 + 'px ' + y2 + 'px, ' + x1 + 'px ' + y2 + 'px, ' + x1 + 'px ' + y1 + 'px)'
      : 'none';
  };
  /* Shut, its words are there but its window is closed; opening, the window
     parts as the card grows and the map shows through it. The shut height is
     taken only once the page is set up, so it is never taken from a passing
     layout and then corrected. */
  settle = () => { [shut, full] = measure(); card.style.height = shut + 'px'; hole(); };
  card.classList.add('is-shut');
  if (styled()) settle();
  const MS = 950, WAIT = 0;
  const ease = (t) => (t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  let t0 = 0;
  const step = (now) => {
    if (!t0) t0 = now + WAIT;
    const t = Math.max(0, Math.min(1, (now - t0) / MS));
    card.style.height = (shut + (full - shut) * ease(t)) + 'px';
    hole();
    if (t < 1) requestAnimationFrame(step);
    else { card.style.height = ''; window.__storyOpening = false; hole(); window.dispatchEvent(new Event('story-opened')); }
  };
  /* It stays shut while the map loads; wellness-map.js opens it once the
     map is halfway there (its style and first tiles are in). */
  let opened = false;
  window.__openStory = () => {
    if (opened) return;
    opened = true;
    /* From exactly where it stands now, to its full height as it is now. */
    const now = card.getBoundingClientRect().height;
    full = measure()[1];
    shut = Math.min(now, full);
    card.style.height = shut + 'px';
    card.classList.remove('is-shut');
    requestAnimationFrame(step);
    /* Next comes in once the window is fully open: its opening runs 0.95s
       after a 0.1s wait (prompt-map.css, .story-window::before). */
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    setTimeout(() => card.classList.add('is-window-open'), still ? 0 : 1100);
  };
  setTimeout(window.__openStory, 8000);
})();
`}></script>}

