<script>
  /* The chrome, the intro and the list are all in the HTML above, so the page
     can paint before the map exists. The map's script is imported rather than
     loaded as this module's own dependency, so the page never waits for it.
     It used to wait for the first frame, or for the browser to go idle, so a
     blank page did not sit there while it compiled; the intro now shows its
     card shut from the first frame and opens it once the map is in, and
     the script's own first step is to wait for the map's data, so asking for
     it at once only gets the live map there sooner. */
  import('../scripts/wellness-map.js');
</script>
